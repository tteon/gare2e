+// GUG experiment patch: cancellation/error must not recycle an active transaction.
+// Successful COMMIT/ROLLBACK releases normally; otherwise take closes the socket.
+struct Lease(Option<ManagedConnection>);
+impl Lease {
+    fn release(&mut self) { drop(self.0.take()); }
+}
+impl std::ops::Deref for Lease {
+    type Target = ManagedConnection;
+    fn deref(&self) -> &Self::Target { self.0.as_ref().expect("released transaction") }
+}
+impl std::ops::DerefMut for Lease {
+    fn deref_mut(&mut self) -> &mut Self::Target { self.0.as_mut().expect("released transaction") }
+}
+impl Drop for Lease {
+    fn drop(&mut self) {
+        if let Some(connection) = self.0.take() {
+            drop(ManagedConnection::take(connection));
+        }
+    }
+}
