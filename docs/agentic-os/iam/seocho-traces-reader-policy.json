{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTracePrefixOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::seocho-agentic-os-traces",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "seocho-agentic-os/traces/*",
            "seocho-agentic-os/traces"
          ]
        }
      }
    },
    {
      "Sid": "ReadTraceObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::seocho-agentic-os-traces/seocho-agentic-os/traces/*"
    }
  ]
}
